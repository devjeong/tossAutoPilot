# ── Supabase (apps/web + apps/engine) ──────────────────────────
# URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_URL=https://xxxx.supabase.co

# 공개 키 — 신규 publishable 또는 레거시 anon JWT (둘 중 하나 + 별칭 권장)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...   # 코드 호환 별칭 (publishable 과 동일 값)

# 서버 키 — 신규 secret 또는 레거시 service_role JWT (절대 브라우저에 노출 금지)
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...            # 코드 호환 별칭 (secret 과 동일 값)

# DB — Direct(db.xxx) 는 IPv6-only 인 경우가 많음. 로컬에선 Session pooler 권장.
# 예: postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_URL_DIRECT=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# (선택) JWT 검증
# SUPABASE_JWKS_URL=https://xxxx.supabase.co/auth/v1/.well-known/jwks.json

# ── 자격증명 암복호화 (Vercel + Worker 동일 값, 32바이트 hex = 64자) ──
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_MASTER_KEY=

# ── Engine 내부 호출 비밀 ──────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ENGINE_INTERNAL_SECRET=
ENGINE_URL=http://127.0.0.1:8787

# ── Toss Open API ──────────────────────────────────────────────
TOSS_BASE_URL=https://openapi.tossinvest.com

# ── 시황 보고서 LLM (R0) ───────────────────────────────────────
# auto: XAI → Anthropic → Gemini → template 순
REPORT_LLM_PROVIDER=auto
# XAI_API_KEY=
# XAI_MODEL=grok-3-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash


# ── Engine ─────────────────────────────────────────────────────
ENGINE_PORT=8787
ENGINE_TICK_MS=5000
ENGINE_HEARTBEAT_MS=10000
ENGINE_QUOTES_INTERVAL_MS=5000
# (선택) 한 유저만 heartbeat. 비우면 engine_status 전원 갱신
# ENGINE_USER_ID=uuid-of-auth-user
